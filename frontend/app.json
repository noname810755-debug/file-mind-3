{
  "expo": {
    "name": "frontend",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.filemindai.muv0o1",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan documents with your camera",
        "NSPhotoLibraryUsageDescription": "Import photos to convert and organize",
        "NSPhotoLibraryAddUsageDescription": "Save scanned documents to your library",
        "NSFaceIDUsageDescription": "Unlock your private Vault"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.emergent.filemindai.muv0o1",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "expo-sqlite",
      "expo-sharing",
      "@react-native-vector-icons/material-design-icons",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan documents with your camera"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Import photos to convert and organize",
          "savePhotosPermission": "Save scanned documents"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock your private Vault"
        }
      ],
      "expo-video",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
